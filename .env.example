# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres

# Registration email (126 SMTP). MAIL_PASS is the client authorization code.
MAIL_USER=
MAIL_PASS=
# MAIL_FROM=
# MAIL_HOST=smtp.126.com
# MAIL_PORT=465

# AI report service
# Supported presets: openai, deepseek, kimi, glm. For another
# OpenAI-compatible provider, set AI_BASE_URL explicitly.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-5-mini
AI_TIMEOUT_MS=120000
# AI_BASE_URL=https://api.openai.com/v1

# Passkeys: the frontend origin, without a trailing slash; RP ID has no scheme or port.
# Local defaults: http://localhost:3001 / localhost. Production requires both.
# WEBAUTHN_ORIGIN=https://your-domain.example
# WEBAUTHN_RP_ID=your-domain.example
# WEBAUTHN_RP_NAME=AGGREGATE
